# Optional companion to the uv setup, for when the CUDA SDK and host compiler are not the
# system ones -- e.g. no root, or a toolkit too old for the installed GPU. Copy to .env in
# the repository root and adjust, then every command picks it up:
#
#     uv run --env-file .env python ./scripts/train.py -c configs/<config>.yaml
#
# Two things shape this file:
#
#  * uv sets PATH itself (the virtualenv first) and discards any PATH assigned here, so tools
#    are named by absolute path. This is enough: torch invokes $CUDA_HOME/bin/nvcc and passes
#    $CC to it via -ccbin, so neither needs to be on PATH.
#  * ${PWD} is expanded by uv at launch, so paths stay relative to the checkout in the file
#    but reach subprocesses as absolute ones. Run uv from the repository root.

CUDA_HOME=${PWD}/.toolchain/cuda-13.2
CUDA_PATH=${PWD}/.toolchain/cuda-13.2
LD_LIBRARY_PATH=${PWD}/.toolchain/cuda-13.2/lib64

# nvcc invokes unversioned `gcc`/`g++`; point these at symlinks if only versioned ones exist.
CC=${PWD}/.toolchain/bin/gcc
CXX=${PWD}/.toolchain/bin/g++
CUDAHOSTCXX=${PWD}/.toolchain/bin/g++

# Build only for the installed GPU instead of every supported architecture.
TORCH_CUDA_ARCH_LIST=12.0
MAX_JOBS=8
